# Bu değerler app.config.ts tarafından okunur ve app.json -> extra'yı ezer.
# Hiçbiri zorunlu değildir: eksikse ilgili SDK sessizce devre dışı kalır ve
# uygulama free katmanda, reklamsız, üyeliksiz çalışmaya devam eder.

# RevenueCat public SDK key'leri (Premium satışı)
REVENUECAT_IOS_KEY=appl_xxx
REVENUECAT_ANDROID_KEY=goog_xxx

# AdMob reklam birimi kimlikleri (yalnızca free katmanda kullanılır)
ADMOB_BANNER_ANDROID=ca-app-pub-xxx/xxx
ADMOB_BANNER_IOS=ca-app-pub-xxx/xxx
ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-xxx/xxx
ADMOB_INTERSTITIAL_IOS=ca-app-pub-xxx/xxx

# Google ile giriş — Firebase Console > Authentication > Google > Web SDK
# yapılandırmasındaki "Web client ID". Boşsa Google butonu gizlenir.
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
