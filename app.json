{
  "expo": {
    "name": "ŞansLab",
    "slug": "sanslab",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sanslab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oditteknoloji.sanslab",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Bu tanımlayıcı, sana daha alakalı reklamlar göstermek için kullanılır."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oditteknoloji.sanslab",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#08071A"
      },
      "permissions": ["com.google.android.gms.permission.AD_ID"],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#08071A",
          "imageWidth": 400,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#08071A"
          },
          "android": {
            "imageWidth": 264
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.256609557198-06jleqrksvhv92q2gm3vasepjaeb1uso"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Bu tanımlayıcı, sana daha alakalı reklamlar göstermek için kullanılır."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBAnalytics",
              "RNFBCrashlytics",
              "RNFBFirestore"
            ]
          },
          "android": { "minSdkVersion": 24 }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": { "projectId": "93ce342c-547b-4e32-bae1-e0783dcc9e96" },
      "revenuecat": {
        "ios": "appl_REPLACE_ME",
        "android": "goog_dKPyVlLtTULJmQxKumJLOOKNhGi"
      },
      "admob": {
        "bannerAndroid": "ca-app-pub-XXXX/XXXX",
        "bannerIos": "ca-app-pub-XXXX/XXXX",
        "interstitialAndroid": "ca-app-pub-XXXX/XXXX",
        "interstitialIos": "ca-app-pub-XXXX/XXXX"
      },
      "auth": {
        "googleWebClientId": "256609557198-q0kgkm2bus1okesl2ld24adp96vkemnb.apps.googleusercontent.com",
        "facebookAppId": "1879696566334647",
        "facebookClientToken": "15d57dda5a4a434e88b254e7089b7241"
      },
      "links": {
        "privacy": "https://odit.com.tr/sanslab/privacy",
        "terms": "https://odit.com.tr/sanslab/terms",
        "support": "mailto:support@odit.com.tr"
      }
    }
  }
}
