{
  "expo": {
    "name": "ŞansLab",
    "slug": "sanslab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sanslab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08071A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oditteknoloji.sanslab",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Bu tanımlayıcı, sana daha alakalı reklamlar göstermek için kullanılır."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oditteknoloji.sanslab",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08071A"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#08071A",
          "imageWidth": 200
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Bu tanımlayıcı, sana daha alakalı reklamlar göstermek için kullanılır."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93ce342c-547b-4e32-bae1-e0783dcc9e96"
      },
      "revenuecat": {
        "ios": "appl_REPLACE_ME",
        "android": "goog_REPLACE_ME"
      },
      "admob": {
        "bannerAndroid": "ca-app-pub-XXXX/XXXX",
        "bannerIos": "ca-app-pub-XXXX/XXXX",
        "interstitialAndroid": "ca-app-pub-XXXX/XXXX",
        "interstitialIos": "ca-app-pub-XXXX/XXXX"
      }
    },
    "owner": "tayfuntemizel"
  }
}
